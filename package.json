{
  "name": "zero-scroll",
  "version": "0.1.0",
  "description": "Virtual scroll engine with zero DOM measurement. Fenwick tree + composable height providers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "virtual-scroll",
    "virtual-list",
    "virtualization",
    "scroll",
    "fenwick-tree",
    "zero-dom",
    "performance",
    "react",
    "pretext"
  ],
  "author": "anhphong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heocoi/zero-scroll"
  },
  "homepage": "https://github.com/heocoi/zero-scroll",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^2.1.9"
  }
}
